{
  "name": "@nox/cli",
  "version": "0.0.1",
  "description": "Nox - starter untuk situs dokumentasi berbasis MDX",
  "type": "module",
  "bin": {
    "nox": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/index.ts"
  },
  "keywords": [
    "nox",
    "documentation",
    "mdx",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
