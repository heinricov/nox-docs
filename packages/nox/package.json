{
  "name": "noxkit",
  "version": "0.0.19",
  "description": "Nox - documentation site starter with MDX support",
  "type": "module",
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "release": "npm version patch --no-git-tag-version && npm publish",
    "release:minor": "npm version minor --no-git-tag-version && npm publish",
    "release:major": "npm version major --no-git-tag-version && npm publish"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.4",
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next-mdx-remote": "^6.0.0",
    "react-element-to-jsx-string": "^17.0.1",
    "react-icons": "^5.7.0",
    "react-is": "^19.2.8",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.17.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@turbo/gen": "^2.9.15",
    "@types/babel__standalone": "^7.1.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9",
    "tailwindcss": "^4"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./globals.css": "./src/styles/globals.css",
    "./styles/*": "./src/styles/*",
    "./postcss.config": "./postcss.config.mjs",
    "./common/*": "./src/common/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./layouts": {
      "types": "./src/layouts/index.ts",
      "default": "./src/layouts/index.ts"
    },
    "./layouts/*": "./src/layouts/*.tsx",
    "./render": {
      "types": "./src/render/index.ts",
      "default": "./src/render/index.ts"
    },
    "./render/*": "./src/render/*.tsx",
    "./mdx-render/*": "./src/mdx-render/*.tsx"
  }
}
